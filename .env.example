# 平台登录会话有效期（秒），到期需要重新登录。
PLATFORM_SESSION_TTL_SECONDS=90
# 后台清理过期会话的周期（秒），不影响令牌实际失效时刻。
PLATFORM_SESSION_CLEANUP_INTERVAL_SECONDS=10

# 建议心跳间隔（秒），必须小于会话有效期。
PLATFORM_HEARTBEAT_INTERVAL_SECONDS=30

# RabbitMQ Stream 连接与业务流名称。
RABBITMQ_HOST='localhost'
RABBITMQ_PORT='5552'
RABBITMQ_VHOST='/'
RABBITMQ_USER='middleware_dev'
RABBITMQ_PASSWORD='replace-with-a-local-development-password'
RABBITMQ_REQUEST_STREAM='ingestion-requests'
RABBITMQ_RESULT_STREAM='ingestion-results'

# 消息保留时间；待接入 RabbitMQ 保留策略后生效。
RABBITMQ_STREAM_MAX_AGE=7D

# 每个流的容量限制（字节），默认 1 GiB；待接入保留策略后生效。
RABBITMQ_STREAM_MAX_LENGTH_BYTES=1073741824

# 注册中心的平台代号，必须对应平台 YAML 的 code。
RABBITMQ_REGISTRY_PLATFORM_CODE=registry

# 每个平台入库流预取缓存上限：消息数与原始消息总字节数。
INGESTION_CACHE_MAX_MESSAGES=100
INGESTION_CACHE_MAX_BYTES=4194304

REVIEW_CACHE_MAX_MESSAGES=100

REVIEW_CACHE_MAX_BYTES=4194304

RABBITMQ_DELETION_REQUEST_STREAM=deletion-requests

RABBITMQ_DELETION_RESULT_STREAM=deletion-results

DELETION_CACHE_MAX_MESSAGES=100

DELETION_CACHE_MAX_BYTES=4194304

# 每个子平台在删除结果流中的预取缓存上限，与入库结果流独立。
DELETION_REVIEW_CACHE_MAX_MESSAGES=100
DELETION_REVIEW_CACHE_MAX_BYTES=4194304
